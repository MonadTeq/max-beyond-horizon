# Шаблон конфига Horizon для docker-compose (M5.3).
#
# Основа — max-horizon-server/smoke_config.toml, но пути и announce_host
# параметризованы. deploy/entrypoint.sh подставляет значения из окружения
# (переменные HORIZON_* / MAX_*) и пишет итоговый TOML в /tmp/horizon/config.toml.
# Сам шаблон в контейнере read-only; для ручной правки меняйте
# docker-compose.yml (environment) или смонтируйте свой HORIZON_CONFIG.

[server]
bind_address = "@HORIZON_WS_BIND@"
max_connections = 100
connection_timeout = 120
use_reuse_port = false
tick_interval_ms = 16

[server.region]
min_x = -5000.0
max_x = 5000.0
min_y = -5000.0
max_y = 5000.0
min_z = -500.0
max_z = 500.0

[server.security]
enable_rate_limiting = false
max_requests_per_minute = 100
max_message_size = 32768
max_json_depth = 8
max_string_length = 512
max_collection_size = 50
enable_ddos_protection = false
banned_ips = []
max_connections_per_ip = 10

# gRPC-листенер (horizon.v1.Horizon). JoinGame отдаёт клиентам announce_host;
# для игры с другой машины задайте HORIZON_ANNOUNCE_HOST=<публичный адрес>.
[server.grpc]
enabled = true
bind_address = "@HORIZON_GRPC_BIND@"
announce_host = "@HORIZON_ANNOUNCE_HOST@"

[plugins]
directory = "/tmp/horizon-plugins"
auto_load = false
whitelist = []

[logging]
level = "info"
json_format = false

[health]
enable_health_checks = false
enable_metrics = false

[monitoring]
enable_prometheus = false
prometheus_port = 9090
enable_jaeger = false

[database]
enabled = false

[tls]
enabled = false

[performance]
worker_threads = 0
blocking_threads = 512
thread_keep_alive_seconds = 10

[limits]
max_memory_mb = 2048
max_cpu_percent = 80.0
max_file_descriptors = 65536

[max]
executable = "@MAX_EXECUTABLE@"
template_dir = "@MAX_TEMPLATE_DIR@"
session_root = "@MAX_SESSION_ROOT@"
# ВАЖНО (M5.2): в game_data не должно быть PATCHES.RES — иначе headless
# падает при загрузке ресурсов. MAX.RES берётся отсюда, PATCHES.RES — из
# template_dir (он там есть и используется клиентом/шаблоном).
game_data = "@MAX_GAME_DATA@"
port_range_start = @MAX_PORT_START@
port_range_end = @MAX_PORT_END@
max_restarts = @MAX_RESTARTS@
session_secret = "@MAX_SESSION_SECRET@"
admin_secret = "@MAX_ADMIN_SECRET@"
