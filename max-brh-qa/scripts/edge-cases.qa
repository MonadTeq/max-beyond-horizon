click 450 150
click 220 280
click 550 420
click 200 40
click 400 100
click 300 200
click 500 300
click 250 400
click 600 50
click 350 350
click 450 150
click 220 280
click 550 420
click 200 40
click 400 100
click 300 200
click 500 300
click 250 400
click 600 50
click 350 350
click 450 150
click 220 280
click 550 420
click 200 40
click 400 100
click 300 200
click 500 300
click 250 400
click 600 50
click 350 350
click 450 150
click 220 280
click 550 420
click 200 40
click 400 100
click 300 200
click 500 300
click 250 400
click 600 50
click 350 350
click 450 150
click 220 280
click 550 420
assert screen=InGame
assert turn=1
shot edge-game-spam

# --- TC-1111: не-ASCII в чате -------------------------------------------
key t
type "Привет, мир! 汉字 🚀"
key ENTER
tick 2
shot edge-unicode-chat
assert screen=InGame

# Строка только из не-ASCII: буфер остаётся пустым, Enter просто закрывает
# ввод (как `Remote_SendNetPacket_18` по пустому сообщению) — без паники.
key t
type "Привет"
key ENTER
tick 1
assert screen=InGame

# --- TC-1111 + TC-1112: не-ASCII в имени игрока и повторный старт -------
select unit 0
assert selected
key ESC             # снять выделение
assert screen=InGame
key ESC             # выйти из партии
assert screen=MainMenu
shot edge-back-to-menu

menu new_game
assert screen=Options
click 100 452       # поле Name
type "Командир 汉字"
key ENTER
shot edge-unicode-name
setup cancel
# `Custom Game` открывается из подменю New Game (menu_new_game_menu_loop):
# Cancel из настройки возвращает в подменю, Esc — в главное меню.
assert screen=NewGameMenu
key ESC
assert screen=MainMenu
shot edge-repeat-start

# --- TC-1112 (UI): второй полный старт после выхода ----------------------
# Тот же `App`, но новая партия: экраны настройки и мобилизация поднимаются
# заново, состояние не «залипает».
menu new_game
assert screen=Options
setup done
setup done
assert screen=Players
setup done
assert screen=Mobilize
mobilize done
assert screen=Landing
landing grid 30 22
landing done
assert screen=InGame
assert turn=1
end_turn
assert turn=2
assert screen=InGame
shot edge-second-game
