# unit-menu.qa — меню команд юнита (C++ `GameManager_PopupButtons`).
#
#   cargo run -q -p max_app --no-default-features --example qa_run -- \
#       ../max-brh-qa/scripts/unit-menu.qa qa-out/unit-menu
#
# Что проверяется (всё — теми же кликами/клавишами, что у игрока):
# * триггер 1:1 из C++: меню открывается **повторным кликом** по уже
#   выделенному своему юниту (`GameManager_ClickUnit` → `InitPopupButtons`),
#   первый клик только выделяет;
# * состав пунктов по типу юнита: у танка — `attack/enter/stop/sentry/Done`
#   (x-fer у танка нет: груз `NONE`), у строителя — `Build` первым и **включённый**
#   `x-fer` (груз `RAW`; `attack` по-прежнему отключён — `unit-menu-disabled`);
# * модальность: пока меню открыто, карта приказ не получает (клик по другому
#   юниту закрывает меню, выделение не меняется);
# * `Esc` закрывает меню и не выходит из партии;
# * выбор пункта вызывает **существующий** обработчик: `sentry` → приказ
#   `ORDER_SENTRY` (пакет 08, процессор P1), `Build` у строителя открывает
#   `BuildMenu`.
#
# Кадры `unit-menu-tank` и `unit-menu-builder` — golden-эталоны
# (`max-brh-qa/golden/unit-menu`).

# --- Главное меню → партия ------------------------------------------------
assert screen=MainMenu
menu new_game
assert screen=Options
click 240 110       # Turn Timers: No Limit
click 500 100       # Play Mode: Turn Based
setup done
assert screen=Planet
setup done
assert screen=Players
players 0 human
players 1 computer
players 2 none
players 3 none
setup done

# --- Мобилизация: танк (строка 5) и строитель (строка 0) ------------------
assert screen=Mobilize
mobilize buy 5
mobilize buy 0
mobilize done
assert screen=Landing
landing grid 30 22
landing done
assert screen=InGame
assert turn=1
tick 5

# --- Танк: первый клик выделяет, второй открывает меню -------------------
select type Tank
assert selected
assert unit-menu=closed
shot unit-menu-tank-selected

# Повторный клик по тому же юниту — меню (C++ `GameManager_ClickUnit`).
unit-menu open
assert unit-menu=open
assert unit-menu-item=sentry
assert unit-menu-item=enter
assert unit-menu-item=Done
assert unit-menu-enabled=attack
# `x-fer` у танка нет вовсе: у него `CARGO_TYPE_NONE`.
assert unit-menu=open
shot unit-menu-tank

# --- Sentry: пункт вызывает приказ (пакет 08, P1) ------------------------
assert unit-order=await
unit-menu item sentry
assert unit-menu=closed
assert unit-order=sentry
assert log=sentry

# Повторное открытие: пункт нажат (`state[i]` в C++), горячая клавиша `8`
# снимает sentry (`ORDER_AWAIT`).
unit-menu open
assert unit-menu-item=sentry
shot unit-menu-sentry-on
key 8
assert unit-menu=closed
assert unit-order=await

# --- Esc закрывает меню, партия продолжается ------------------------------
unit-menu open
assert unit-menu=open
key ESC
assert unit-menu=closed
assert screen=InGame
assert selected

# --- Модальность: клик по карте закрывает меню и не меняет выделение ----
unit-menu open
assert unit-menu=open
# Клик по соседней клетке (не по юниту): меню модально — приказа нет.
click 500 300
assert unit-menu=closed
assert selected

# --- Строитель: меню → Build открывает BuildMenu -------------------------
select type Constructor
assert selected
unit-menu open
assert unit-menu=open
assert unit-menu-item=Build
assert unit-menu-item=x-fer
shot unit-menu-builder
unit-menu item Build
assert unit-menu=closed
assert build=open
key ESC
assert build=closed
assert screen=InGame

# =========================================================================
# B1: пункты, которые раньше были disabled (C++ `UnitsManager_Popup_OnClick_*`)
# =========================================================================

# --- attack: тумблер targeting_mode (units_manager.cpp:617) --------------
select type Tank
unit-menu open
assert unit-menu-enabled=attack
assert targeting=off
unit-menu item attack
assert unit-menu=closed
assert targeting=on
unit-menu open
assert targeting=on
shot unit-menu-targeting
key 3
assert unit-menu=closed
assert targeting=off

# --- Upg. All: материалы комплекса + ORDER_UPGRADE (units_manager.cpp:414)
spawn Power Station
select type Power Station
complex raw 200
# Апгрейд доступен, когда текущие значения команды выше базы
# (`UnitInfo::HasUpgradeableAttributes`).
teamvalues Power Station hits 150
unit-menu open
assert unit-menu-enabled=Upg. All
unit-menu item Upg. All
assert unit-menu=closed
assert unit-order=upgrade
tick 5

# --- load: курсорный режим 7 (units_manager.cpp:1011) --------------------
spawn Personnel Carrier
select type Personnel Carrier
assert selected
spawn Infantry
unit-menu open
assert unit-menu-enabled=load
unit-menu item load
assert cursor=load
unit-menu open
assert unit-menu-item=load
shot unit-menu-load
unit-menu item load
assert cursor=none

# --- disable/steal: курсорные режимы диверсанта (8/9) --------------------
spawn Infiltrator
select type Infiltrator
assert selected
unit-menu open
assert unit-menu-enabled=disable
assert unit-menu-enabled=steal
shot unit-menu-infiltrator
unit-menu item disable
assert cursor=disable
unit-menu open
unit-menu item steal
assert cursor=steal
unit-menu open
unit-menu item attack
assert targeting=on
unit-menu open
key 3
assert targeting=off

# --- бульдозер: пункт remove включён (Access_GetRemovableRubble) ---------
spawn Bulldozer
select type Bulldozer
unit-menu open
assert unit-menu-enabled=remove
unit-menu close

# --- remove: диалог самоуничтожения (UnitsManager_SelfDestructMenu) ------
# Последним: взрыв переводит здание в `ORDER_EXPLODE`/`DESTROY`, и другие
# `select type` с тем же именем больше не должны его выбирать.
spawn Power Station
select type Power Station
unit-menu open
assert unit-menu-enabled=remove
unit-menu item remove
assert self-destruct=open
shot self-destruct-arm
selfdestruct arm
selfdestruct advance 400
shot self-destruct-armed
selfdestruct ok
assert self-destruct=closed
assert unit-order=explode
assert screen=InGame
