# move-input.qa — сквозной путь игрока мышью (регресс «юнит не двигается»).
#
# Меню → Options → Planet → Players (RED человек, GREEN компьютер) →
# мобилизация (Done) → высадка (Enter подтверждает точку по умолчанию) → партия:
# клик по своему юниту (assert selected/unit-pos), LMB на соседнюю клетку
# (assert preview + лог «Move: N steps»), End Turn → позиция юнита изменилась.
# Кнопки мыши — как в оригинале (`game_manager.cpp:6685-6778`): LMB = выбор/
# меню/приказ-движение, RMB = выбор/контекст (статистика) или отмена режимов.
#
# Координаты — пиксели кадра 640×480. После старта камера центрирована на шахте
# (`GameManager_GetFirstRelevantUnit` → `Access_GetFirstMiningStation`):
# шахта (22,22) → (404,242), Surveyor (23,21) → (468,178),
# соседняя клетка (24,21) → (532,178). Именно эта привязка — суть регресса:
# до фикса камера вставала на первую плиту (`GROUND_COVER` в каноническом
# обходе юнитов, клетка (21,23)), поэтому рассчитанные от базы клики попадали
# на клетку вниз-влево и выделяли стационарную шахту — приказ отвечал
# «Unit cannot move (air/stationary)», предпросмотра не было, ход не двигал юнита.
#
# Все переходы — те же клики, что у реальной мыши: `menu`/`setup`/`players`/
# `mobilize done` жмут настоящие кнопки, высадка — Enter, выделение/приказ —
# click/rclick по кадру.

# --- Меню → настройка -----------------------------------------------------
assert screen=MainMenu
menu new_game
assert screen=Options

# --- Options → Planet → Players ------------------------------------------
setup done
assert screen=Planet
setup done
assert screen=Players
players 0 human
players 1 computer
players 2 none
players 3 none

# --- Мобилизация ----------------------------------------------------------
setup done
assert screen=Mobilize
mobilize done
assert screen=Landing

# --- Высадка: Enter подтверждает точку по умолчанию ----------------------
key ENTER
assert screen=InGame
assert turn=1
assert team=0
# Стартовые 7 юнитов RED (шахта, генератор, 2 плиты, 3 мобильных) в партии.
assert units>=7
tick 5
# Golden: камера на шахте, стартовые юниты видны спрайтами (не пустая карта).
shot game-start

# --- TC-0601: панель статистики здания (шахта) ----------------------------
# Шахта (22,22) → (404,242): стационарная, у неё нет Speed. C++ рисует
# Hits, Cargo (ATTRIB_STORAGE 25) и запас комплекса в строке 3; строка 4
# (Shots) пустая. Клик выделяет именно шахту (а не плиту под ней).
click 404 242
assert unit-pos=22,22
shot mine-selected

# --- Выделение своего юнита кликом ---------------------------------------
click 468 178
assert selected
assert unit-pos=23,21
assert log=Selected
shot game-selected

# --- LMB на соседнюю клетку: зелёный маршрут + журнал --------------------
# Оригинал `game_manager.cpp:6685-6745`: приказ движения — левая кнопка
# (`CURSOR_UNIT_GO` → `ORDER_MOVE`); правая кнопка только выбирает/отменяет.
click 532 178
assert preview
assert log=Move:
shot move-preview

# --- End Turn: приказ исполняется, юнит в новой клетке -------------------
tick 8
end_turn
assert turn>=2
assert team=0
# C++ `GameManager_UpdateGuiControl` сбрасывает выделение на смене хода,
# поэтому юнит в новой клетке выделяется заново — тем же кликом мыши.
shot game-turn2
click 532 178
assert selected
assert unit-pos=24,21
# Угол — по ходу движения (TC-0933): шаг на восток → angle=2 (`Paths_GetAngle`),
# а не 0/45° «по инерции» от предыдущего положения.
assert angle=2
shot game-after

# --- TC-0604: RMB по выбранному юниту — полные характеристики ---------------
# Оригинал `game_manager.cpp:6747-6753`: на выбранном юните правая кнопка
# открывает `UnitStats_Menu` (`STATS`, `unitstats.cpp`) — модальное окно
# с портретом, описанием и полной таблицей характеристик; приказ не отдаётся,
# выделение сохраняется. `Esc`/`Done`/`Enter` закрывают окно.
rclick 532 178
assert log=Unit stats
assert unit-stats=open
assert selected
shot unit-stats
# `?`/`Help` — `HelpMenu_Menu("STATS_SETUP")` поверх окна (режим помощи:
# клик по элементу открывает запись). После закрытия помощи окно статистики
# остаётся (`UnitStatsMenu::Run`).
key ?
assert help-section=stats
help click 100 100
assert help=open
assert help-entry=UNIT_PICTURE
help done
assert unit-stats=open
help close
assert unit-stats=open
key ESC
assert unit-stats=closed
assert selected

# --- TC-0605: миникарта, RMB — приказ движения -----------------------------
# Оригинал `game_manager.cpp:6688-6699`: правая кнопка на миникарте берёт клетку
# `GameManager_GetMinimapPosition` и при `CURSOR_UNIT_GO` отдаёт `ORDER_MOVE`
# выбранному юниту (левая кнопка только центрует камеру). Миникарта 112×112
# в (15,356) — для карты 112×112 пиксель = (15+gx, 356+gy).
# Возврат в (23,21), где Surveyor уже стоял (клетка гарантированно проходима).
rclick 38 377
assert preview
assert log=Move:
tick 8
end_turn
assert turn>=3
click 468 178
assert selected
assert unit-pos=23,21

# Возврат в (24,21) — итоговая позиция сценария остаётся прежней (сквозная
# проверка «приказ → движение» для живой мыши).
click 532 178
assert preview
tick 8
click 532 178
assert selected
assert unit-pos=24,21
