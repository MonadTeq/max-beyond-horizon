# save-load.qa — сохранение и загрузка настоящего V70-сейва (P3, слой 2 QA).
#
#   cargo run -p max_app --no-default-features --example qa_run -- \
#       ../max-brh-qa/scripts/save-load.qa qa-out/save-load
#
# Что проверяется:
# * локальная партия играется два хода (`end_turn` человека + ход ИИ);
# * `save_v70` пишет **настоящий** V70-файл (`GameState::to_save_bytes`),
#   а не контейнер MXLS: его читает `SaveFile::parse` и C++-порт;
# * автосейв конца раунда создаёт `save10.dta` (C++ `SETUP.auto_save`);
# * `load` поднимает партию из этого файла в свежем состоянии приложения:
#   ход, число юнитов и экран совпадают с сохранёнными (`assert turn`,
#   `assert units`), партия продолжает играться (`end_turn` после загрузки);
# * кадры `save-menu`/`after-load` — для визуальной проверки окна и партии.
#
# Триаж 2026-11-24 (pre-existing red): ожидание `units=14` устарело после `ai A.3`
# (73b9d38, «port build orders + production»): ИИ теперь начинает стройку на своём
# ходу (`PlanNextBuildJob`/`choose_build_orders`), а стройплощадка — это
# юниты-декали `LargeTape`/`LargeCones`/`SmallTape`/`SmallCones`/`LargeSlab`/
# `SmallSlab`. К ходу 3 в мире 20 юнитов: RED — 7 (5 боевых + 2 плиты под
# зданиями), GREEN — 13 (5 боевых + 2 плиты + 2 площадки по 3 декали).
# В сейве ровно те же 20 (`SaveFile::parse`: 20 записей UnitInfo), `load`
# восстанавливает все 20 — **потерь нет** (именно это сценарий и проверяет);
# 6 «лишних» появились ДО сохранения, на ходу ИИ.

# --- Главное меню → локальная партия -------------------------------------
shot main-menu
assert screen=MainMenu
menu new_game

# --- Options: No Limit + Turn Based (детерминизм без таймеров) -----------
assert screen=Options
click 240 110
click 500 100
setup done
assert screen=Planet

# --- Planet ---------------------------------------------------------------
setup done
assert screen=Players

# --- Players: RED — человек, GREEN — компьютер ---------------------------
players 0 human
players 1 computer
players 2 none
players 3 none
setup done

# --- Мобилизация и высадка ------------------------------------------------
assert screen=Mobilize
mobilize done
assert screen=Landing
landing grid 30 22
landing done
assert screen=InGame
assert turn=1
tick 5

# --- Два хода: End Turn человека, ход компьютера, новый раунд ------------
end_turn
end_turn
assert screen=InGame
assert turn=3
assert units>=10

# --- Сохранение партии в V70 ---------------------------------------------
save_v70 turn2.dta
assert turn=3

# --- Окно Save Game (клавиша S, как Alt+F в C++) -------------------------
key s
shot save-menu
key ESC

# --- Загрузка в свежем состоянии приложения ------------------------------
load turn2.dta
assert screen=InGame
assert turn=3
# 20, а не 14: +6 юнитов — декали двух стройплощадок ИИ, начатых на его ходу
# (ai A.3, 73b9d38). Все 20 есть и в сейве, и после загрузки — потерь нет.
assert units=20
shot after-load

# --- Партия после загрузки продолжает играться ---------------------------
end_turn
assert screen=InGame
assert turn>=3

# Итог: сейв/загрузка не сломали цикл хода; число юнитов не изменилось.
assert units=20
