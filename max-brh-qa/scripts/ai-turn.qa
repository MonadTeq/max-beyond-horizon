# ai-turn.qa — конец хода человека, ход компьютера и возврат управления (A3).
#
# Путь игрока: главное меню → Options (No Limit + Simultaneous Moves) → Planet →
# Players (RED — человек, GREEN — компьютер) → мобилизация без покупок →
# высадка → **клик по End Turn** → кадры хода компьютера → возврат хода.
#
#   cargo run -p max_app --no-default-features --example qa_run -- \
#       ../max-brh-qa/scripts/ai-turn.qa qa-out/ai-turn
#
# Что проверяется (C++ `GameManager_UpdateGui`, `game_manager.cpp:2437-2492`):
# * на ходу человека кнопка End Turn **отжата** (`TEAM_TYPE_PLAYER` →
#   `GameManager_MenuClickEndTurnButton(true)` → `SetRestState(false)`) и
#   подпись обычная (`FontColor(0xA0, 0xA2, 0xE6)`, `game_manager.cpp:7838`);
# * на ходу компьютера кнопка **нажата** (`TEAM_TYPE_COMPUTER` →
#   `MenuClickEndTurnButton(0)` → `SetRestState(true)`) — ресурс
#   `R_ENDT_D + team` (`R_ENDT_D/G_ENDT_D/B_ENDT_D/W_ENDT_D`) с подписью
#   «End Turn» цветом активной команды (`FontColor(team + 1, team + 1, 0x3F)`,
#   `game_manager.cpp:7860-7883`);
# * таймер хода компьютера стартует с `settings["endturn"]` (по умолчанию 45 с,
#   `settings.cpp:118`; в кадре «00:45»), на ходе человека при No Limit — «00:00»
#   цветом `COLOR_RED` (`turn_time <= 20`);
# * **ход компьютера закрывает таймер `endturn`, а не счётчик**
#   (`AiPlayer::CheckEndTurn` в не-turn-based режиме не зовёт `RefreshOrders`,
#   `aiplayer.cpp:2843-2848`; таймер — `GameManager_HandleTurnTimer`,
#   `game_manager.cpp:893-916`, мин 15 с, дефолт 45 с): после 200 кадров
#   (~3.3 с) ход ИИ ещё идёт, а счётчик `end_turn_retry_counter > 120` его бы уже
#   закрыл;
# * после 45 с (2700 кадров) кнопка снова отжата, ход возвращается человеку.
#
# Решение владельца 2026-11-25: ход ИИ в реальном времени закрывается по таймеру
# `endturn` (1:1 оракул), а не по `end_turn_retry_counter > 120`; счётчик остаётся
# fallback при отсутствии настройки (`End Turn: None`). Поэтому golden-кадры
# `ai-turn` пересняты: ход ИИ длится 45 с (2700 кадров) и успевает изменить карту,
# а не 2 с (121 кадр), как раньше.

# --- Главное меню ---------------------------------------------------------
assert screen=MainMenu
menu new_game

# --- Options --------------------------------------------------------------
# No Limit (таймер хода человека выключен) + Simultaneous Moves (реальный
# режим: ход ИИ закрывается таймером `endturn`).
assert screen=Options
click 240 110
# Play Mode: строка «Simultaneous Moves» (480,115)-(580,145), центр (530,130).
click 530 130
setup done
assert screen=Planet

# --- Planet ---------------------------------------------------------------
setup done
assert screen=Players

# --- Players --------------------------------------------------------------
players 0 human
players 1 computer
players 2 none
players 3 none
setup done

# --- Мобилизация и высадка ------------------------------------------------
mobilize done
assert screen=Landing
landing grid 30 22
landing done
assert screen=InGame
assert turn=1
tick 5

# --- Ход человека: кнопка отжата -----------------------------------------
assert endturn=normal
assert team=RED
shot ai-turn-human-normal

# --- Клик по End Turn: начинается ход компьютера -------------------------
# Кнопка End Turn — (390,2) 72×21 (`WINDOW_ENDTURN_BUTTON`), центр (426,12).
click 426 12
# Один кадр: `GameManager_UpdateGui` для `TEAM_TYPE_COMPUTER` уже выставил
# нажатый вид, а таймер — 45 с.
tick 1
assert team=GREEN
assert endturn=pressed
shot ai-turn-ai-pressed

# Таймер, а не счётчик: к 200-му кадру `end_turn_retry_counter` уже перешёл бы
# порог 120, но в реальном времени ход ИИ продолжается до конца окна `endturn`.
tick 200
assert phase=ai
assert team=GREEN
assert endturn=pressed

# 900 тиков = 15 с из 45 с: панель показывает остаток «00:30» (кадр
# `ai-turn-ai-timer`), ход ИИ всё ещё идёт — окно задаёт таймер `endturn`.
tick 700
assert phase=ai
shot ai-turn-ai-timer

# `wait` крутит кадры до возврата управления человеку: окно 45 с = 2700 тиков.
wait 4000
assert phase=player
assert endturn=normal
assert team=RED
assert turn>=2

# `GameManager_UpdateGui` → `GameManager_ProgressBuildState` →
# `GameManager_ReportNewUnitsMessage` (`game_manager.cpp:8103`): начало хода
# человека открывает окно «Begin turn N.» над картой (в этот ход построек нет).
assert hint=Begin turn
shot ai-turn-human-again

# Партия продолжается, счётчик ходов вырос.
assert screen=InGame
