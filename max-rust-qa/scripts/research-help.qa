# research-help.qa — ResearchMenu (P7) + Help-экраны (режим + запись).
#
#   cargo run -p max_app --no-default-features --example qa_run -- \
#       ../max-rust-qa/scripts/research-help.qa qa-out/research-help
#
# Что проверяется:
# * кнопки `?` экранов настройки открывают **режим помощи** C++
#   (`HelpMenu_Menu`, `helpmenu.cpp:315`): окна нет, курсор — `CURSOR_HELP`;
# * запись выбирается **кликом по элементу** (`Help::GetEntry`, `help.cpp:140`):
#   окно показывает ровно один абзац `help.json`, а не всю секцию;
# * `help entry NAME` кликает по центру записи (тот же путь, что у игрока);
#   `help click X Y` — произвольная точка (пустая точка режим не выключает);
# * окно прокручивается (`PageDown`/`PageUp`), `Done`/`Enter` закрывает окно и
#   возвращает в режим, `help close` (`Esc` в режиме) выключает режим;
# * экран исследований открывается клавишей `R` для включённого Research
#   Center (`ResearchMenu`, popup `Research` в C++): `RSRCHPIC`, 8 тем, центры
#   по темам, `+N%`, ходы до завершения;
# * распределение центров: `UPGLFT` Attack освобождает центр (`free_capacity`),
#   `UPGRGRT` Shots закрепляет его; `Done` (`ResearchMenu_OnClick_Done`) пишет
#   новое распределение в `GameState`;
# * после 16 ходов уровень Shots растёт (`ResearchMenu_NewTurn` из
#   `finish_turn`), а Attack остаётся 0 — то есть экран реально влияет на тик;
# * кадры `help-options/planet/newgame/cargo/research/game/keys`,
#   `research-menu`, `research-plan` — эталоны golden/research-help/.

# --- Главное меню ---------------------------------------------------------
assert screen=MainMenu
menu new_game

# --- Help: OPTIONS_SETUP (кнопка ?) --------------------------------------
assert screen=Options
help options
assert help-section=OPTIONS_SETUP
# Окна ещё нет: это режим выбора элемента (`HelpMenu_Menu`).
assert help=closed
# Клик по пустому месту окно не открывает и режим не выключает.
help click 5 5
assert help=closed
assert help-section=OPTIONS_SETUP
# Клик по элементу `COMPUTER_OPPONENT` (7..211, 39..227) открывает запись.
help click 100 130
assert help=open
assert help-entry=COMPUTER_OPPONENT
assert help-row=0
shot help-options
help page down
assert help-row=0
help done
assert help=closed
assert help-section=OPTIONS_SETUP
# `PLAY_MODE` — другая запись той же секции (окно показывает её, не секцию).
help entry PLAY_MODE
assert help-entry=PLAY_MODE
assert help=open
shot help-options-playmode
help done
help close
assert help=closed
assert screen=Options
setup done

# --- Help: PLANET_SETUP ---------------------------------------------------
assert screen=Planet
help planet
assert help-section=PLANET_SETUP
assert help=closed
help entry DESC_WINDOW
assert help=open
assert help-entry=DESC_WINDOW
shot help-planet
help done
help close
assert screen=Planet
setup done

# --- Help: NEW_GAME_SETUP (Players) --------------------------------------
assert screen=Players
players 0 human
players 1 computer
players 2 none
players 3 none
help newgame
assert help-section=NEW_GAME_SETUP
help entry OPTION_BUTTON
assert help-entry=OPTION_BUTTON
shot help-newgame
help done
help close
assert screen=Players
setup done

# --- Help: CARGO_SETUP (CargoMenu) ---------------------------------------
assert screen=Mobilize
help cargo
assert help-section=CARGO_SETUP
assert help=closed
help entry LIST
assert help-entry=LIST
shot help-cargo
help done
help close
assert help=closed
assert screen=Mobilize

# --- Мобилизация и старт партии ------------------------------------------
mobilize done
assert screen=Landing
landing grid 30 22
landing done
assert screen=InGame
assert turn=1
tick 5

# --- Строим Research Center (как research.qa) ----------------------------
select type Constructor
assert selected
build open
build select 11
build done
assert build-site=open
build place near
assert build-site=closed
end_turn
end_turn
end_turn
end_turn
end_turn
end_turn
end_turn
end_turn
end_turn
end_turn
end_turn
end_turn
assert unit=Research Center
select type Constructor
assert hint=Finished building Research Center
move near
assert unit-order=activate
tick 30
assert build-ready=no
assert builder=outside
assert site=none

# --- Включаем питание ----------------------------------------------------
select type Research Center
key o
tick 10

# --- ResearchMenu: раскладка и распределение -----------------------------
research open
assert research-menu=open
assert research-alloc attack=1
shot research-menu

# --- Help: RESEARCH_SETUP (кнопка Help экрана исследований) --------------
help research
assert help-section=RESEARCH_SETUP
assert help=closed
help entry TITLE_BAR
assert help=open
assert help-entry=TITLE_BAR
shot help-research
help page down
assert help-row=0
help done
assert help=closed
assert help-section=RESEARCH_SETUP
help close
assert help=closed
assert research-menu=open

# Attack -> 0 (освобождает центр), Shots -> 1 (закрепляет его).
research row 0 down
assert research-alloc attack=1
research row 1 up
assert research-alloc attack=1
research done
assert research-menu=closed
assert research-alloc attack=0
assert research-alloc shots=1
shot research-plan

# --- Help: GAME_SCREEN_SETUP (панель HELP_OF) + Keys ---------------------
help game
assert help-section=GAME_SCREEN_SETUP
assert help=closed
# Клик по кнопке `FILES` (17..83, 4..20) — запись `FILES_BUTTON`.
help entry FILES_BUTTON
assert help=open
assert help-entry=FILES_BUTTON
shot help-game
help done
assert help=closed
assert help-section=GAME_SCREEN_SETUP
# `Keys` (`_(ceb6)`) — кнопка окна `GAME_SCREEN_SETUP`: текст длиннее страницы.
help entry FILES_BUTTON
assert help=open
help keys
assert help=open
help page down
assert help-row>=16
shot help-game-keys
help done
help close
assert help=closed
assert screen=InGame

# --- Тик исследований: Shots растёт, Attack стоит ------------------------
end_turn
end_turn
end_turn
end_turn
end_turn
end_turn
end_turn
end_turn
end_turn
end_turn
end_turn
end_turn
end_turn
end_turn
end_turn
end_turn
assert research attack=0
assert research shots>=1
assert screen=InGame
