# visual-screens.qa — проход по всем экранам клиента (слой 3: golden-кадры).
#
# Каждый ключевой экран снимается в PNG. Набор кадров этого скрипта —
# эталоны `qa/golden/*.png`; сверка:
#
#   cargo run -p max_app --example qa_run -- qa/visual-screens.qa qa-out/visual-screens
#   cargo run -p max_app --example qa_golden_check -- qa-out/visual-screens qa/golden
#
# Партия заканчивается честно: в Options лимит ходов Duration = 1, поэтому
# первый же закрытый раунд даёт экран победы/поражения (`winloss`) — без
# «телепортации» в конец игры.

# --- Меню -----------------------------------------------------------------
shot main-menu
assert screen=MainMenu

# TC-0108: Introduction (MVE-видео INTROFLC → maxint.mve) и Credits
# (прокрутка титров). Экран титров снимается не пустым: 100 кадров по 1/60 с —
# ~166 шагов прокрутки (10 мс на шаг, шаг = 1 пиксель), видны первые строки.
menu intro
assert screen=Introduction
# dt = 0: первый кадр MVE — детерминированный стоп-кадр (тёмный фон).
shot intro
# 3.5 с видео (15 FPS): к кадру ~52 на экране логотип Interplay — вторая
# golden-точка доказывает, что кадры декодируются и меняются со временем.
tick 210
assert screen=Introduction
shot intro-logo
key ESC
assert screen=MainMenu

menu credits
assert screen=Credits
tick 100
shot credits
key ESC
assert screen=MainMenu

menu new_game
shot options
assert screen=Options

# Лимит победы по ходам = 1: клик по полю «turns» открывает редактирование
# (в буфере стоит текущее значение 50), поэтому сначала чистим поле.
click 460 378
key BACKSPACE
key BACKSPACE
key BACKSPACE
type "1"
key ENTER
setup done

# --- Планета и команды ----------------------------------------------------
shot planet
assert screen=Planet
setup done

players 0 human
players 1 computer
players 2 none
players 3 none
shot players
assert screen=Players
setup done

# --- Фазы старта: мобилизация и выбор точки высадки -----------------------
assert screen=Mobilize
shot mobilize
mobilize done
assert screen=Landing
shot landing
landing grid 22 22
landing done
assert screen=InGame

# --- Партия ---------------------------------------------------------------
assert turn=1
tick 10
shot game

# TC-0601: панель статистики здания. Шахта (22,22) → (404,242) — стационарная:
# C++ `GameManager_UpdateInfoDisplay` рисует Hits, Cargo (ATTRIB_STORAGE 25) и
# запас комплекса (строка 3, `_(d28b)`), а Speed/Shots с нулевой базой не рисует.
click 404 242
assert unit-pos=22,22
shot mine-selected

# A6: кнопка SURVEY (`GameManager_DisplayButtonSurvey`) включает оверлей иконок
# ресурсов (`GameManager_RenderSurveyIndicator`), даже без выделенного разведчика.
assert survey-overlay=no
click 31 306
assert survey-overlay=yes
shot survey-button
click 31 306
assert survey-overlay=no

# TC-0919: портрет CORNER_FLIC — FLC-анимация выделенного юнита. Камера стоит
# на шахте (22,22) → (404,242); Surveyor (23,21) → (468,178), как в move-input.qa.
# В QA `dt = 0`, поэтому кадр портрета — первый кадр FLC (`SURVEYOR.FLC`),
# детерминизм golden.
click 468 178
assert selected
shot portrait

# A6: выделенный разведчик включает тот же оверлей
# (`GameManager_IsSurveyorSelected`, `Access_IsSurveyorOverlayActive`), а вокруг
# выделенного юнита появляется индикатор `GameManager_DrawUnitSelector`.
assert survey-overlay=yes
assert unit-selector=yes
# Иконки ресурсов рисуются `Survey_RenderMarkers` только на **разведанных**
# клетках и **после** юнитов (`GameManager_RenderSurveyIndicator`).
assert resource-icons>=1
shot survey

# Первый же закрытый раунд заканчивает партию по лимиту ходов.
end_turn
assert screen=GameOver
shot winloss

# --- Сетевые экраны меню (клиент лобби — заглушка QA) ---------------------
key ENTER                 # OK экрана победы → MainMenu
assert screen=MainMenu

menu multiplayer
shot multiplayer
assert screen=MultiplayerMenu

menu join
shot join-list
assert screen=JoinList
