# production.qa — производство/строительство (P2, слой 2 QA).
#
# Путь игрока целиком: главное меню → Options → Planet → Players (RED — человек,
# GREEN — компьютер) → мобилизация без покупок (150 кредитов остаются на
# производство) → высадка → выделение конструктора → BuildMenu → заказ
# Training Hall (10 ходов) → здание появляется → выделение завода →
# BuildMenu завода → заказ Infantry (2 хода) → юнит появляется.
#
#   cargo run -p max_app --no-default-features --example qa_run -- \
#       ../max-rust-qa/scripts/production.qa qa-out/production
#
# Что проверяется:
# * `BuildMenu` открывается для конструктора и показывает список зданий
#   (`CONBUILD`, 15 строк `max_builder_capability_list[CONSTRCT]`);
# * заказ уходит `Command::Order` с `PayloadP4` и строится 10 ходов
#   (`ATTRIB_TURNS` TRAINHAL), золото списывается по ставке C++
#   (`Cargo_GetRawConsumptionRate(CONSTRCT, 1) = 2` за ход);
# * построенное здание появляется в конце хода (`SpawnNewUnit`) и его видно
#   ассертом `assert unit=Training Hall`;
# * завод строит пехоту 2 хода (`ATTRIB_TURNS` INFANTRY) и юнит появляется.

# --- Главное меню ---------------------------------------------------------
shot main-menu
assert screen=MainMenu
menu new_game

# --- Options --------------------------------------------------------------
# No Limit + Turn Based: ходы воспроизводимы без настенных часов.
assert screen=Options
click 240 110
click 500 100
setup done
assert screen=Planet

# --- Planet ---------------------------------------------------------------
shot planet
setup done
assert screen=Players

# --- Players --------------------------------------------------------------
players 0 human
players 1 computer
players 2 none
players 3 none
shot players
setup done

# --- Мобилизация ----------------------------------------------------------
# Ничего не покупаем: 150 кредитов — бюджет производства.
assert screen=Mobilize
shot mobilize
mobilize done
assert screen=Landing

# --- Высадка --------------------------------------------------------------
landing grid 30 22
landing done
assert screen=InGame
assert turn=1
tick 5

# --- BuildMenu конструктора: заказ здания и ВЫБОР МЕСТА --------------------
# Конструктор из загрузки SC_L0001 (порядок в списке юнитов зависит от
# развёртывания базы, поэтому выбираем по имени).
select type Constructor
assert selected
build open
assert build=open
shot buildmenu
# TRAINHAL — 14-я строка списка CONSTRCT (индекс 13, порядок Lua-таблицы).
build select 13
build done
assert build=closed
# C++ `MobileBuildMenu::Build` для здания (`base_unit.GetFlags() & BUILDING`):
# заказ ЕЩЁ НЕ отдан — `UnitsManager_SetNewOrderInt(unit, ORDER_BUILD,
# ORDER_STATE_SELECT_SITE)` и временная лента `LRGTAPE` (призрак 2×2,
# `GameManager_TempTape`). Ни приказа, ни площадки в мире пока нет.
assert build-site=open
assert build-site=valid
assert unit-order=await
assert site=none
shot build-site-select

# Невалидная клетка: курсор правее строителя уводит 2×2 на занятую клетку —
# `CURSOR_UNIT_NO_GO`; в кадре виден призрак, но LMB по такой клетке в C++
# отменяет выбор целиком (`GameManager_ManagePlayerAction`).
build cursor 30 21
assert build-site=invalid
shot build-site-invalid
key ESC
assert build-site=closed
assert unit-order=await
assert site=none

# Подтверждение: заказ → выбор клетки → LMB. Площадка ставится ТУДА, куда
# указал игрок: клик по (28,20) → якорь 2×2 в (28,20) (`PathBuild`:
# `move_to = TempTape->grid`), лента-призрак исчезает.
build open
build select 13
build done
assert build-site=open
build place 28 20
assert build-site=closed
assert unit-order=build
# Площадка появляется на кадре обработки `ORDER_BUILD`/`INIT`, как C++
# `UnitsManager_ProcessOrderBuild` → `UnitInfo::StartBuilding`:
# `DeployConstructionSiteUtilities` (LRGTAPE+LRGCONES) + `PrepareConstructionSite`
# (LRGSLAB, кадр из RNG).
tick 1
assert site=large
assert site-pos=28,20
shot build-ordered

# --- Скольжение в центр ленты под углом (`PositionInTape`) -----------------
# C++ (`unitinfo.cpp:4414-4482`): пока строитель не довернулся
# (`Paths_UpdateAngle` к `GetTargetUnitAngle`), `moved` не растёт — сначала
# поворот на месте. Затем четыре тика `OffsetDrawZones(DIRECTION_OFFSETS[angle]
# * 8)` двигают спрайт по диагонали к центру 2×2; на следующем тике
# `RestoreOrders` и доворот `(angle + 1) & 7` на рабочую позу.
# Строитель стоит в SE-углу ленты (29,21), якорь (28,20) → угол NW(7).
tick 1
assert angle=7
assert build-center=no
shot build-slide-turn
tick 1
assert build-center=no
shot build-slide-1
tick 1
assert build-center=no
shot build-slide-2
tick 1
assert build-center=no
shot build-slide-3
tick 1
assert build-center=yes
shot build-slide-4

# --- Отмена стройки и повторный заказ (строитель не «застревает») ---------
# C++ `UnitsManager_Popup_InitBuilders`: во время `ORDER_BUILD` пункт `Build`
# заменён на `stop` (`GameManager_SelectBuildSite` → `ORDER_STATE_BUILD_CANCEL`,
# `UnitInfo::CancelBuilding` у мобильного строителя очищает очередь).
# Позиционирование в ленте (`AWAIT_TAPE_POSITIONING`) занимает 4 тика движения
# плюс доворот перед въездом; после него конструктор в
# `ORDER_BUILD`/`BUILD_IN_PROGRESS`, угол довёрнут на `(angle + 1) & 7` (N), и
# меню снова показывает `stop`. Открываем меню повторным кликом (`unit-menu
# open`).
tick 1
assert unit-order=build
assert angle=0
unit-menu open
assert unit-menu=open
unit-menu item stop
assert unit-menu=closed
# `CancelBuilding` исполняется процессором приказа на следующем тике.
tick 1
assert unit-order=await
# `CancelBuilding` мобильного строителя: `Access_DestroyUtilities(... true ...)`
# — площадка снимается целиком (лента, конусы, плита).
assert site=none
# Строитель снова готов строить: `Build` вернулся в меню.
unit-menu open
assert unit-menu-item=Build
unit-menu item Build
assert build=open
build select 13
build done
assert build=closed
# Повторный заказ снова идёт через выбор места; `place near` подтверждает
# клетку самого строителя (якорь 2×2 — накрывающий её; здесь (28,20)).
assert build-site=open
build place near
assert build-site=closed
assert unit-order=build
tick 1
assert site=large
assert site-pos=28,20
# `assert site=drawn` — декали не просто есть в состоянии, а **нарисованы**:
# каждая (лента, конусы, плита) даёт свои пиксели в кадре. В C++
# `UnitInfoGroup::IsRelevant` рисует только не-`ORDER_IDLE` юнитов, поэтому
# декали обязаны быть `ORDER_AWAIT`, как `UnitInfo::UnitInfo`.
assert site=drawn
shot build-site

# «Вырастание» постройки (C++ `UnitsManager_ProcessOrderAwaitScaling` +
# `UnitInfo::RenderSprite`: масштаб `2^-scaler_adjust`). `tick`/`shot` идут с
# `dt = 0` — детерминированный полный размер; `anim` прокручивает только
# визуальные часы, поэтому кадры роста воспроизводимы.
anim 60
shot build-site-grow
anim 1000
shot build-site-grown

# Покадровая анимация строителя (C++ `UnitsManager_ProcessOrderBuild`:
# конструктор листает `+8`, при `image_index + 8 >= 40` — `-16`, то есть
# `+16 → +24 → +32`). После 4 кадров `AWAIT_TAPE_POSITIONING` конструктор
# возвращается в `ORDER_BUILD`/`BUILD_IN_PROGRESS` и начинает работу.
tick 6
assert unit-order=build
# `UnitInfo::PositionInTape` + `OffsetDrawZones`: спрайт строителя сдвинут на
# 8 px × 4 тика = 32 px (половина клетки) к центру ленты 2×2 — рабочая поза
# стоит ровно в центре площадки, сетка строителя не меняется.
assert build-center=yes
assert unit-pos=29,21
shot build-work-a
anim 150
shot build-work-b

# --- 10 ходов постройки (ATTRIB_TURNS TRAINHAL) --------------------------
end_turn
end_turn
end_turn
end_turn
end_turn
end_turn
end_turn
end_turn
end_turn
end_turn
assert unit=Training Hall
assert build=closed
# По завершении (`SpawnNewUnit` + `UnitsManager_BuildingReady`) лента и конусы
# убраны, плита осталась фундаментом, здание стоит в клетке площадки.
assert site=none

# --- BuildMenu завода: очередь и заказ пехоты ----------------------------
# Завод — стационарный юнит: `select unit` его не видит, выбираем по имени.
select type Training Hall
assert unit=Training Hall
build open
assert build=open
shot buildmenu-factory
# Список TRAINHAL = [COMMANDO, INFANTRY]: выбираем пехоту (индекс 1).
build select 1
build add
build done
assert build=closed

# --- 2 хода постройки (ATTRIB_TURNS INFANTRY) ----------------------------
end_turn
end_turn
assert unit=Infantry
shot production-done

# Итог: партия продолжается, производство не сломало цикл хода.
assert screen=InGame
assert turn>=12
