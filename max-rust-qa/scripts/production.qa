# production.qa — производство/строительство (P2, слой 2 QA).
#
# Путь игрока целиком: главное меню → Options → Planet → Players (RED — человек,
# GREEN — компьютер) → мобилизация без покупок (150 кредитов остаются на
# производство) → высадка → выделение конструктора → BuildMenu → заказ
# Training Hall (10 ходов) → здание появляется → выделение завода →
# BuildMenu завода → заказ Infantry (2 хода) → юнит появляется.
#
#   cargo run -p max_app --no-default-features --example qa_run -- \
#       ../max-rust-qa/scripts/production.qa qa-out/production
#
# Что проверяется:
# * `BuildMenu` открывается для конструктора и показывает список зданий
#   (`CONBUILD`, 15 строк `max_builder_capability_list[CONSTRCT]`);
# * заказ уходит `Command::Order` с `PayloadP4` и строится 10 ходов
#   (`ATTRIB_TURNS` TRAINHAL), золото списывается по ставке C++
#   (`Cargo_GetRawConsumptionRate(CONSTRCT, 1) = 2` за ход);
# * построенное здание появляется в конце хода (`SpawnNewUnit`) и его видно
#   ассертом `assert unit=Training Hall`;
# * завод строит пехоту 2 хода (`ATTRIB_TURNS` INFANTRY) и юнит появляется.

# --- Главное меню ---------------------------------------------------------
shot main-menu
assert screen=MainMenu
menu new_game

# --- Options --------------------------------------------------------------
# No Limit + Turn Based: ходы воспроизводимы без настенных часов.
assert screen=Options
click 240 110
click 500 100
setup done
assert screen=Planet

# --- Planet ---------------------------------------------------------------
shot planet
setup done
assert screen=Players

# --- Players --------------------------------------------------------------
players 0 human
players 1 computer
players 2 none
players 3 none
shot players
setup done

# --- Мобилизация ----------------------------------------------------------
# Ничего не покупаем: 150 кредитов — бюджет производства.
assert screen=Mobilize
shot mobilize
mobilize done
assert screen=Landing

# --- Высадка --------------------------------------------------------------
landing grid 30 22
landing done
assert screen=InGame
assert turn=1
# Ход человека (TEAM_TYPE_PLAYER): кнопка End Turn отжата (A3).
assert endturn=normal
tick 5

# --- BuildMenu конструктора: заказ здания и ВЫБОР МЕСТА --------------------
# Конструктор из загрузки SC_L0001 (порядок в списке юнитов зависит от
# развёртывания базы, поэтому выбираем по имени).
select type Constructor
assert selected
build open
assert build=open
shot buildmenu
# TRAINHAL — 14-я строка списка CONSTRCT (индекс 13, порядок Lua-таблицы).
build select 13
build done
assert build=closed
# C++ `MobileBuildMenu::Build` для здания (`base_unit.GetFlags() & BUILDING`):
# заказ ЕЩЁ НЕ отдан — `UnitsManager_SetNewOrderInt(unit, ORDER_BUILD,
# ORDER_STATE_SELECT_SITE)` и временная лента `LRGTAPE` (призрак 2×2,
# `GameManager_TempTape`). Ни приказа, ни площадки в мире пока нет.
assert build-site=open
assert build-site=valid
assert unit-order=await
assert site=none
shot build-site-select

# Невалидная клетка: курсор правее строителя уводит 2×2 на занятую клетку —
# `CURSOR_UNIT_NO_GO`; в кадре виден призрак, но LMB по такой клетке в C++
# отменяет выбор целиком (`GameManager_ManagePlayerAction`).
build cursor 30 21
assert build-site=invalid
shot build-site-invalid
key ESC
assert build-site=closed
assert unit-order=await
assert site=none

# Подтверждение: заказ → выбор клетки → LMB. Площадка ставится ТУДА, куда
# указал игрок: клик по (28,20) → якорь 2×2 в (28,20) (`PathBuild`:
# `move_to = TempTape->grid`), лента-призрак исчезает.
build open
build select 13
build done
assert build-site=open
build place 28 20
assert build-site=closed
assert unit-order=build
# Плита появляется МГНОВЕННО при подтверждении места — до первого тика: заказ
# применяется сразу (`DeployConstructionSiteUtilities` + `PrepareConstructionSite`
# — `LRGTAPE`+`LRGCONES`+`LRGSLAB`, кадр плиты из RNG), а не на кадре обработки
# `ORDER_BUILD`/`INIT`. Поэтому и `assert site=large`, и `site=drawn` проходят
# без `tick`.
assert site=large
assert site-pos=28,20
assert site=drawn
shot build-placed

tick 1
assert site=large
assert site-pos=28,20
shot build-ordered

# --- Скольжение в центр ленты под углом (`PositionInTape`) -----------------
# C++ (`unitinfo.cpp:4414-4482`): пока строитель не довернулся
# (`Paths_UpdateAngle` к `GetTargetUnitAngle`), `moved` не растёт — сначала
# поворот на месте. Затем четыре тика `OffsetDrawZones(DIRECTION_OFFSETS[angle]
# * 8)` двигают спрайт по диагонали к центру 2×2; на следующем тике
# `RestoreOrders` и доворот `(angle + 1) & 7` на рабочую позу.
# Строитель стоит в SE-углу ленты (29,21), якорь (28,20) → угол NW(7).
tick 1
assert angle=7
assert build-center=no
shot build-slide-turn
tick 1
assert build-center=no
shot build-slide-1
tick 1
assert build-center=no
shot build-slide-2
tick 1
assert build-center=no
shot build-slide-3
tick 1
assert build-center=yes
shot build-slide-4

# --- Отмена стройки и повторный заказ (строитель не «застревает») ---------
# C++ `UnitsManager_Popup_InitBuilders`: во время `ORDER_BUILD` пункт `Build`
# заменён на `stop` (`GameManager_SelectBuildSite` → `ORDER_STATE_BUILD_CANCEL`,
# `UnitInfo::CancelBuilding` у мобильного строителя очищает очередь).
# Позиционирование в ленте (`AWAIT_TAPE_POSITIONING`) занимает 4 тика движения
# плюс доворот перед въездом; после него конструктор в
# `ORDER_BUILD`/`BUILD_IN_PROGRESS`, угол довёрнут на `(angle + 1) & 7` (N), и
# меню снова показывает `stop`. Открываем меню повторным кликом (`unit-menu
# open`).
tick 1
assert unit-order=build
assert angle=0
unit-menu open
assert unit-menu=open
unit-menu item stop
assert unit-menu=closed
# `CancelBuilding` исполняется процессором приказа на следующем тике.
tick 1
assert unit-order=await
# `CancelBuilding` мобильного строителя: `Access_DestroyUtilities(... true ...)`
# — площадка снимается целиком (лента, конусы, плита).
assert site=none
# Строитель снова готов строить: `Build` вернулся в меню.
unit-menu open
assert unit-menu-item=Build
unit-menu item Build
assert build=open
build select 13
build done
assert build=closed
# Повторный заказ снова идёт через выбор места; `place near` подтверждает
# клетку самого строителя (якорь 2×2 — накрывающий её; здесь (28,20)).
assert build-site=open
build place near
assert build-site=closed
assert unit-order=build
tick 1
assert site=large
assert site-pos=28,20
# `assert site=drawn` — декали не просто есть в состоянии, а **нарисованы**:
# каждая (лента, конусы, плита) даёт свои пиксели в кадре. В C++
# `UnitInfoGroup::IsRelevant` рисует только не-`ORDER_IDLE` юнитов, поэтому
# декали обязаны быть `ORDER_AWAIT`, как `UnitInfo::UnitInfo`.
assert site=drawn
shot build-site

# «Вырастание» постройки (C++ `UnitsManager_ProcessOrderAwaitScaling` +
# `UnitInfo::RenderSprite`: масштаб `2^-scaler_adjust`). `tick`/`shot` идут с
# `dt = 0` — детерминированный полный размер; `anim` прокручивает только
# визуальные часы, поэтому кадры роста воспроизводимы.
anim 60
shot build-site-grow
anim 1000
shot build-site-grown

# Покадровая анимация строителя (C++ `UnitsManager_ProcessOrderBuild`:
# конструктор листает `+8`, при `image_index + 8 >= 40` — `-16`, то есть
# `+16 → +24 → +32`). После 4 кадров `AWAIT_TAPE_POSITIONING` конструктор
# возвращается в `ORDER_BUILD`/`BUILD_IN_PROGRESS` и начинает работу.
tick 6
assert unit-order=build
# `UnitInfo::PositionInTape` + `OffsetDrawZones`: спрайт строителя сдвинут на
# 8 px × 4 тика = 32 px (половина клетки) к центру ленты 2×2 — рабочая поза
# стоит ровно в центре площадки, сетка строителя не меняется.
assert build-center=yes
assert unit-pos=29,21
shot build-work-a
anim 150
shot build-work-b

# --- Подсказка строящего юнита (сверху карты) ----------------------------
# C++ `GameManager_UnitSelect` → `GameManager_DrawUnitStatusMessage` →
# `GameManager_DrawBuilderUnitStatusMessage` (`_(ee24)`): «Currently building:
# X.» + «Turns to completion: N.» в окне `MESSAGE_BOX_INFO` над картой.
# Смена хода сбрасывает выделение (`GameManager_UpdateGuiControl`), поэтому
# клик по строителю на ходе 2 снова показывает подсказку.
end_turn
select type Constructor
assert hint=Currently building: Training Hall
assert hint=Turns to completion: 9
shot build-hint

# --- Оставшиеся 9 ходов постройки (ATTRIB_TURNS TRAINHAL) ----------------
end_turn
end_turn
end_turn
end_turn
end_turn
end_turn
end_turn
end_turn
end_turn

# --- Достройка 1:1: строитель ЖДЁТ приказа игрока -------------------------
# C++ `UnitInfo::SpawnNewUnit` (`unitinfo.cpp:3440`): здание встаёт на клетку
# ленты в `ORDER_IDLE`/`ORDER_STATE_BUILDING_READY` (не рисуется —
# `UnitInfoGroup::IsRelevant`), а строитель получает `ORDER_BUILD`/
# `ORDER_STATE_UNIT_READY` и остаётся на площадке. Лента и конусы ещё на месте,
# ухода НЕТ: его инициирует игрок (`game_manager.cpp:6879-6890`).
assert unit=Training Hall
assert build=closed
assert build-ready=yes
assert site=large
assert builder=inside
# Выделение сброшено началом хода — клик по строителю даёт «Finished building».
select type Constructor
assert hint=Finished building Training Hall
# A4: строитель остаётся в ЦЕНТРЕ ленты до приказа игрока — C++
# `SpawnNewUnit` не двигает его `x`/`y`, сдвиг `PositionInTape` (+32 px) снимается
# только в `TAPE_POSITIONING_DEINIT`/`LEAVE` (`unitinfo.cpp:4414-4482`).
assert build-center=yes
# A8: индикатор выделения вокруг строителя — `GameManager_DrawUnitSelector`
# (`game_manager.cpp:744`), три вложенные рамки с мигающим `MarkerColor`.
assert unit-selector=yes
# Кадр «строитель ждёт»: лента/конусы/плита на месте, вокруг строителя —
# мигающие маркеры `BLDMRK1..5` (`DrawMap_RenderBuildMarker`), здание скрыто.
shot build-done-waiting
assert unit-order=build
assert builder=inside
assert build-ready=yes

# Приказ движения ИГРОКОМ (RMB по клетке рядом):
# `ORDER_ACTIVATE`/`ORDER_STATE_IN_TRANSITION` с `move_to` = клетка клика.
move near
assert unit-order=activate
assert builder=inside
shot build-done-leaving
# `PositionInTape` DEINIT/LEAVE: доворот к `move_to` и четыре шага по 8 px —
# после них клетка строителя пересчитывается от пиксельной позиции
# (`grid_x = x / GFX_MAP_TILE_SIZE`), он оказывается за габаритом 2×2.
tick 6
assert builder=inside
# `tick 12` — доворот (до 4 шагов) + четыре шага по 8 px + выход на клетку
# клика: строитель покидает габарит 2×2.
tick 12
assert builder=outside
# `UnitsManager_BuildingReady`: строитель вне габаритов 2×2 → утилиты сняты
# (`remove_slabs = false`, плита осталась фундаментом), здание раскрывается
# `ScaleUnit(EXPAND)`.
tick 16
assert builder=outside
assert site=none
assert build-ready=no
shot build-done

# --- Комплекс завода: склад вплотную к цеху + общий котёл -------------------
# C++ `UnitsManager_UpdateConnectors` (`units_manager.cpp:2051-2225`) сливает
# здания команды через коннекторы в ОДИН комплекс, а завод тратит сырьё
# комплекса (`Complex::GetCargoInfo` — сумма складов, `complex.cpp:136-147`;
# `Cargo_GetNetProduction` вычитает ставку из `complex->material`). Цех,
# построенный на (28,20), стоит по диагонали к шахте (30,22) — коннектора нет.
# Ставим ADUMP в клетку (30,21): она примыкает и к цеху (29,21), и к шахте
# (30,22), поэтому все три здания попадают в один комплекс.
select type Constructor
assert unit-pos=29,22
spawn ADump
assert unit=ADump
# `complex raw N` — QA-only `Complex::Transfer(raw,0,0)`: кладёт сырьё в общий
# котёл **выделенного** комплекса (раскладывается по складам членов).
select type Training Hall
complex raw 60
assert complex-raw>=50
# Склад в комплексе цеха реально получил сырьё — значит коннекторы слили их.
select type ADump
assert unit-storage>=1
select type Training Hall
assert unit=Training Hall

# --- BuildMenu завода: очередь и заказ пехоты ----------------------------
# Завод — стационарный юнит: `select unit` его не видит, выбираем по имени.
build open
assert build=open
shot buildmenu-factory
# Список TRAINHAL = [COMMANDO, INFANTRY]: выбираем пехоту (индекс 1).
build select 1
build add
build done
assert build=closed

# Завод с очередью: C++ НЕ листает кадры корпуса по времени
# (`max-original-dasm/formats/unit-animation.md` §7.2). Пока идёт `ORDER_BUILD`,
# `UnitInfo::StartBuilding` (`unitinfo.cpp:2789`) держит кадр `image_base + 1`;
# видимое мигание включённого завода дают палитровые циклы
# `World::InitColorCycles` (слоты 9–30 @6/9/2 fps). `anim 600` проворачивает
# палитру на 0.6 с, `anim 34` (~1/30 с) корпус не меняет — кадр статичен.
anim 600
shot factory-work-a
anim 34
shot factory-work-b

# --- 2 хода постройки (ATTRIB_TURNS INFANTRY) ----------------------------
# Завод платит МАТЕРИАЛАМИ СВОЕГО КОМПЛЕКСА (`Cargo_GetRawConsumptionRate` →
# `UnitInfo::StartBuilding`/`Cargo_GetNetProduction`), а не золотом команды:
# кредиты после мобилизации не тратятся, сырьё берётся из общего котла
# (ADUMP + шахта), подключённого коннекторами.
end_turn
end_turn
assert unit=Infantry
assert gold>=150
shot production-done

# --- Готовый юнит стоит В ЗАВОДЕ, пока игрок не выведет его ----------------
# C++ `UnitInfo::SpawnNewUnit` (`unitinfo.cpp:3489-3520`): юнит рождается на
# клетке завода (`UnitsManager_DeployUnit(..., grid_x, grid_y, ...)`), получает
# `ORDER_IDLE`/`ORDER_STATE_STORE` и `scaler_adjust = 4` (не рисуется:
# `UnitInfoGroup::IsRelevant` пропускает `ORDER_IDLE`), завод — его родитель,
# а сам юнит становится родителем завода (`SetParent(factory_unit)`), у завода
# `storage = 1` и `ORDER_BUILD`/`ORDER_STATE_UNIT_READY`. Свободная клетка рядом
# не ищется — раньше порт ставил юнита на землю, это было расхождение.
select type Training Hall
assert factory-ready=yes
assert unit-stored=Infantry
shot factory-unit-ready

# Повторный клик по заводу (`UnitsManager_Popup_InitFactories`,
# `units_manager.cpp:869-872`) меню НЕ открывает: `PlaceNewUnit` выбирает
# готового юнита, следующий клик по клетке рядом даёт `CURSOR_ACTIVATE`
# (`game_manager.cpp:6918-6926`) → `ORDER_ACTIVATE` заводу →
# `UnitsManager_ActivateUnit` (`units_manager.cpp:3826-3913`).
unit-menu open
launch near
tick 6
assert unit-order=await
assert selected
shot factory-unit-launched

# Завод отдал юнита: `--storage`, `parent = nullptr`, очередь пуста.
select type Training Hall
assert factory-ready=no
assert unit-stored=none

# Материалы комплекса: шахта копит сырьё, которым платит завод.
select type Mining Station
assert unit-storage>=1

# Итог: партия продолжается, производство не сломало цикл хода.
assert screen=InGame
assert turn>=12
