// settings.jsonc — конфигурация окна клиента M.A.X. : Beyond Rust Horizon.
//
// Назначение: разрешение рендера и параметры окна. Все параметры — только
// презентация: симуляция, snapshot/CRC, сессия и golden 1:1 от них не зависят.
//
// Приоритет: CLI > settings.jsonc > дефолт.
//   • --hd / --hd-scale N   заменяют display.scale / display.resolution;
//   • --aa 0|off|1|2|4      заменяет display.aa;
//   • --scale N             заменяет window.scale;
//   • --fullscreen          включает window.fullscreen;
//   • --settings ПУТЬ       читает другой файл вместо этого.
// Файл читается один раз при запуске; выбор разрешения или сглаживания в меню
// окна (Settings → Resolutions / Antialiasing) применяется на лету, но файл не
// перезаписывает — чтобы закрепить выбор между запусками, укажите его здесь.
//
// Формат — JSONC: разрешены комментарии // и /* … */ и запятые в конце строк.
// Неизвестные секции и параметры — ошибка запуска (защита от опечаток).

{
  // ── Секция display: разрешение кадра (презентация) ──────────────────────
  // Задайте ОДНО из двух: scale или resolution. Если задать оба, значения
  // должны совпадать, иначе запуск остановится с понятной ошибкой.
  "display": {
    // Кратность S: 1 = 640x480 (pixel-perfect, байт-в-байт golden 1:1),
    //              2 = 1280x960 (HD x2), 4 = 2560x1920 (HD x4).
    // Ремастер поставляется только в x2 и x4; другие числа запрещены.
    "scale": 1,
    // Альтернатива: размер кадра строкой. Поддерживаются ровно
    // "640x480", "1280x960", "2560x1920". Чтобы использовать — закомментируйте
    // "scale" выше и раскомментируйте строку ниже.
    // "resolution": "640x480"

    // Сглаживание SSAA (super-sampling; только для HD-кадра, при S > 1).
    // Множитель aa: 0/1 = выключено (по умолчанию), 2 или 4 = кадр рисуется
    // в S·aa и сводится целочисленным box-фильтром aa×aa обратно в S.
    // Сглаживает края геометрии; сплошные участки не меняются. Симуляция,
    // snapshot/CRC и golden 1:1 от aa не зависят.
    // При display.scale = 1 сглаживание принудительно выключено (golden 1:1
    // байт-в-байт). Допустимы только {2,4}: 3/8/… — ошибка запуска.
    // Флаг --aa 0|off|1|2|4 заменяет это значение; меню окна
    // Settings → Antialiasing меняет его на лету (файл не перезаписывается).
    "aa": 0
  },

  // ── Секция window: окно ────────────────────────────────────────────────
  "window": {
    // Целочисленный масштаб окна поверх кадра: 1..=8, либо 0 — подобрать
    // под рабочий стол. По умолчанию (0) окно занимает максимально
    // возможную часть экрана при сохранении nearest-neighbour.
    // Флаг --scale N заменяет это значение (--scale 0 — снова авто).
    "scale": 0,

    // Полноэкранный безрамочный режим при запуске.
    // Alt+Enter переключает его в игре; --fullscreen включает принудительно.
    "fullscreen": false
  }
}
