# Rust workspace artifacts
max-brh/target/

# insta: pending/rejected snapshots are review artifacts; only *.snap is committed
*.snap.new
*.snap.pending

# C++ font reference generator (собирается tools/font_vectors/run.sh)
max-brh/tools/font_vectors/font_vectors


# Сборочные артефакты (основные и промежуточные; bin/ легко удалить целиком)
bin/


# Smoke data dir (MAX.RES + PATCHES.RES together)
build/game-data-smoke/

!max-brh-cicd/scripts/
!max-brh-cicd/scripts/**

# QA-артефакты слоя 2–3: логи, кадры прогонов, diff-*.png, *.mxs
# (эталоны лежат в max-brh-qa/golden/ и коммитятся)
max-brh/qa-out/


# QA work outputs
max-brh-qa/out/

# Пользовательские настройки (C++ settings.json): пишутся рядом с сейвами
max-original/preferences.ini

# max-resources-viewer: PNG-экспорт регенерируется из MAX.RES (коммитится только README)
max-brh-assets/images/
max-brh-qa-tools/max-resources-viewer/target/
max-brh-qa-tools/max-resources-viewer/*.png
!max-brh-qa-tools/max-resources-viewer/screenshot.png

# max-resources-viewer: файловые логи headless-режимов (GUI-подсистема без консоли)
export-log.txt
report.txt
max-resources-viewer-error.txt

# max-resources-exporter: по-юнитная выгрузка (93 каталога) регенерируется из
# MAX.RES / PATCHES.RES / COLOR.PAL / *.FLC; в git — только README и manifest.csv.
max-brh-assets/units/*/
max-brh-qa-tools/max-resources-exporter/target/
ci-run.log

__pycache__/
*.pyc


.tmp/

# R0 measurement tool (separate Cargo project, owns its own target/).
max-brh-qa-tools/r0-measure/target/

# R2 remaster encoder (separate Cargo project, owns its own target/). Its artifacts —
# lossless sample sources, `.ktx2` and `remaster-manifest.json` — live in the repo-root
# `target/` (remaster-hd.md §Ассет-пайплайн) and are regenerated by the tool, never committed.
max-brh-qa-tools/remaster-encode/target/
/target/

# NSIS installer build output (staging lives under .tmp/ and is ignored above).
